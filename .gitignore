## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
.vscode/

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/

# Docker
.env
*.env.local
*.env.production

# Sensitive data - DO NOT COMMIT
**/appsettings.Development.json
**/appsettings.Production.json
deploy/k8s/secret.yaml
*.pfx
*.p12
*.key
*.pem

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs and temporary folders
**/Logs/**
**/TemporaryFolder*/**
**/DataBaseChatBot/**
**/DatabaseLogIBox/**
**/BackUpDB*/**

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Data folders
data/
wwwroot/uploads/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
